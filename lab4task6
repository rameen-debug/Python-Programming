#Write a Python program that verifies if a person can vote (age ≥ 18) and is a registered voter.

#Prompt the user to enter their age
age = int(input("Enter your age: "))

if age >= 18:
    registration=str(input("Are you registered (Yes/No)? ")).lower()
    if registration == "yes":
        print("You can vote.")
    else:
        print("You are eligible by age but not registered, so you can't vote.")
else:
    print("You are under 18, so you can't vote.")
