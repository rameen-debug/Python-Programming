#Task 2: Create a function that takes two numbers as input and checks if the first number is greater than or equal to the second.
#Creating a function
def is_greater_or_equal (first, second):
    return first >= second

#Prompt the user to enter the two numbers
a = float(input("Enter the first number: ")) 
b = float(input("Enter the second number: "))

#Check the given condition
print("Checking if the first number is greater than or equal to the second: " , is_greater_or_equal(a,b))
