#Create two sets
A = {1,2,5,6,7}
B = {1,3,7,9,6}
#Print the two sets
print("\nSet A:" ,A)
print("Set B:" ,B)
#Take their union and intersection
union = A | B #| used for union
intersection = A & B #& used for intersection
#Print the union and intersection of sets A and B
print("Union of sets:" ,union)
print("Intersection of sets:" ,intersection,"\n")
